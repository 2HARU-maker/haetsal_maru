rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isManager() {
      return isSignedIn()
        && ((request.auth.token.keys().hasAny(['manager'])
            && request.auth.token.manager == true)
          || (request.auth.token.keys().hasAny(['admin'])
            && request.auth.token.admin == true));
    }

    function isCouponEventDocId(docId) {
      return docId.matches('coupon_event_.*');
    }

    function isOfflineCouponUseDocId(docId) {
      return docId.matches('offline_coupon_use_.*');
    }

    function isCouponRecordResolutionDocId(docId) {
      return docId.matches('coupon_record_resolution_.*');
    }

    function isCouponLedgerDocId(docId) {
      return isCouponEventDocId(docId)
        || isOfflineCouponUseDocId(docId)
        || isCouponRecordResolutionDocId(docId);
    }

    function isCouponRecalcRunDocId(docId) {
      return docId.matches('coupon_recalc_run_.*');
    }

    function isCouponRecalcItemDocId(docId) {
      return docId.matches('coupon_recalc_item_.*');
    }

    function isCouponRecalcLatestDocId(docId) {
      return docId.matches('coupon_recalc_latest_.*');
    }

    function isCouponRecalcDocId(docId) {
      return isCouponRecalcRunDocId(docId)
        || isCouponRecalcItemDocId(docId)
        || isCouponRecalcLatestDocId(docId);
    }

    function isOrderEditDiagnosticDocId(docId) {
      return docId.matches('order_edit_diagnostic_.*');
    }

    function runtimePolicy() {
      return get(
        /databases/$(database)/documents/haetsalCombinedApp/app_runtime_policy
      ).data;
    }

    function hasValidClientEnvelope() {
      let policy = runtimePolicy();
      return isSignedIn()
        && policy.writeEnabled is bool
        && policy.writeEnabled == true
        && policy.minAllowedBuildNumber is int
        && policy.requiredWriteSchemaVersion is int
        && request.resource.data.clientBuildNumber is int
        && request.resource.data.clientBuildLabel is string
        && request.resource.data.writeSchemaVersion is int
        && request.resource.data.clientWriteAt is string
        && request.resource.data.clientWriteId is string
        && request.resource.data.clientWriteId.size() > 0
        && request.resource.data.clientBuildNumber >= policy.minAllowedBuildNumber
        && request.resource.data.writeSchemaVersion >= policy.requiredWriteSchemaVersion;
    }

    function isFreshClientCreate() {
      return hasValidClientEnvelope();
    }

    function isFreshClientUpdate() {
      return hasValidClientEnvelope()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['clientWriteId', 'clientWriteAt']);
    }

    function hasPayloadMap() {
      return request.resource.data.data is map;
    }

    function isSharedPeopleAuthDocId(docId) {
      return docId == 'shared_people_auth';
    }

    function hasValidSharedPeopleAuthShape(data) {
      return data is map
        && data.keys().hasAll([
          'auth',
          'users',
          'deletedUserIds',
          'deletedUserKeys'
        ])
        && data.auth is map
        && data.users is list
        && data.deletedUserIds is map
        && data.deletedUserKeys is map;
    }

    function validSharedPeopleAuthCreate(docId) {
      let data = request.resource.data.data;
      return isSharedPeopleAuthDocId(docId)
        && isAdmin()
        && isFreshClientCreate()
        && hasPayloadMap()
        && hasValidSharedPeopleAuthShape(data);
    }

    function validSharedPeopleAuthUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isSharedPeopleAuthDocId(docId)
        && isFreshClientUpdate()
        && hasPayloadMap()
        && before is map
        && hasValidSharedPeopleAuthShape(after)
        && (
          isAdmin()
          || (
            after.auth == before.auth
            && after.deletedUserIds == before.deletedUserIds
            && after.deletedUserKeys == before.deletedUserKeys
          )
        );
    }

    function isLiveOrderDocId(docId) {
      return docId.matches('live_order_.*');
    }

    function isCouponBalanceGuardedDocId(docId) {
      return docId == 'shared_people_auth'
        || isLiveOrderDocId(docId)
        || isCouponLedgerDocId(docId)
        || isCouponRecalcDocId(docId);
    }

    function hasCouponBalanceGuardSchema(docId) {
      return !isCouponBalanceGuardedDocId(docId)
        || (
          request.resource.data.writeSchemaVersion is int
          && request.resource.data.writeSchemaVersion >= 5
        );
    }

    function isDoneStatus(status) {
      return status is string
        && (status == 'PICKUP_DONE' || status == 'DELIVERY_DONE');
    }

    function isCompletionRequestStatus(status) {
      return status is string
        && (
          status == 'PENDING'
          || status == 'PROCESSING'
          || status == 'COMPLETED'
          || status == 'NEEDS_CHECK'
        );
    }

    function hasValidCompletionIdentity(data, docId) {
      return data is map
        && data.orderId is string
        && data.orderId.size() > 0
        && data.liveOrderDocId is string
        && data.liveOrderDocId.matches('live_order_.*')
        && data.productionCycle is int
        && data.productionCycle >= 1
        && data.completionEventId is string
        && data.completionEventId == docId;
    }

    function completionRequestMatchesCommittedState(data, docId) {
      let live = getAfter(
        /databases/$(database)/documents/haetsalCombinedApp/$(data.liveOrderDocId)
      ).data.data;
      return data.status == 'COMPLETED'
        && isDoneStatus(live.status)
        && live.orderId == data.orderId
        && live.liveOrderDocId == data.liveOrderDocId
        && live.productionCycle == data.productionCycle
        && live.completionCommitted == true
        && live.completionEventId == docId;
    }

    function validCompletionRequestCreate(docId) {
      let data = request.resource.data.data;
      return isFreshClientCreate()
        && hasPayloadMap()
        && hasValidCompletionIdentity(data, docId)
        && data.type == 'ORDER_COMPLETION_REQUEST'
        && data.status is string
        && (data.status == 'PENDING' || data.status == 'PROCESSING')
        && data.completionOperationId is string
        && data.requestedAt is string
        && data.requestedBy is string
        && data.attemptCount is int
        && data.attemptCount >= 0
        && data.lastAttemptAt is string
        && data.lastError is string;
    }

    function allowedCompletionRequestTransition(beforeStatus, afterStatus) {
      return (
          beforeStatus == 'PENDING'
          && (
            afterStatus == 'PENDING'
            || afterStatus == 'PROCESSING'
            || afterStatus == 'COMPLETED'
            || afterStatus == 'NEEDS_CHECK'
          )
        )
        || (
          beforeStatus == 'PROCESSING'
          && (
            afterStatus == 'PENDING'
            || afterStatus == 'PROCESSING'
            || afterStatus == 'COMPLETED'
            || afterStatus == 'NEEDS_CHECK'
          )
        )
        || (
          beforeStatus == 'NEEDS_CHECK'
          && (
            afterStatus == 'PENDING'
            || afterStatus == 'PROCESSING'
            || afterStatus == 'COMPLETED'
            || afterStatus == 'NEEDS_CHECK'
          )
        )
        || (beforeStatus == 'COMPLETED' && afterStatus == 'COMPLETED');
    }

    function validCompletionRequestUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isFreshClientUpdate()
        && hasPayloadMap()
        && before is map
        && hasValidCompletionIdentity(after, docId)
        && before.type == 'ORDER_COMPLETION_REQUEST'
        && after.type == 'ORDER_COMPLETION_REQUEST'
        && before.orderId == after.orderId
        && before.liveOrderDocId == after.liveOrderDocId
        && before.productionCycle == after.productionCycle
        && before.completionEventId == after.completionEventId
        && before.completionOperationId == after.completionOperationId
        && before.requestedAt == after.requestedAt
        && before.requestedBy == after.requestedBy
        && isCompletionRequestStatus(before.status)
        && isCompletionRequestStatus(after.status)
        && allowedCompletionRequestTransition(before.status, after.status)
        && after.attemptCount is int
        && before.attemptCount is int
        && after.attemptCount >= before.attemptCount
        && after.lastAttemptAt is string
        && after.lastError is string
        && (
          after.status != 'COMPLETED'
          || completionRequestMatchesCommittedState(after, docId)
        );
    }

    function completionEventMatchesCommittedState(data, docId) {
      let live = getAfter(
        /databases/$(database)/documents/haetsalCombinedApp/$(data.liveOrderDocId)
      ).data.data;
      let completionRequest = getAfter(
        /databases/$(database)/documents/haetsalOrderCompletionRequests/$(docId)
      ).data.data;
      return isDoneStatus(data.status)
        && isDoneStatus(live.status)
        && live.orderId == data.orderId
        && live.liveOrderDocId == data.liveOrderDocId
        && live.productionCycle == data.productionCycle
        && live.statusRevision == data.statusRevision
        && live.completionCommitted == true
        && live.completionEventId == docId
        && live.isOpen == false
        && live.workStage == 'DONE'
        && completionRequest.orderId == data.orderId
        && completionRequest.liveOrderDocId == data.liveOrderDocId
        && completionRequest.productionCycle == data.productionCycle
        && completionRequest.completionEventId == docId
        && completionRequest.status == 'COMPLETED';
    }

    function validCompletionEventCreate(docId) {
      let data = request.resource.data.data;
      return isFreshClientCreate()
        && hasPayloadMap()
        && hasValidCompletionIdentity(data, docId)
        && data.type == 'ORDER_COMPLETED'
        && data.operationType == 'production-complete'
        && data.statusRevision is int
        && data.statusRevision >= 1
        && data.workStage == 'DONE'
        && data.processedAt is string
        && data.processedBy is string
        && data.createdAt is string
        && completionEventMatchesCommittedState(data, docId);
    }

    function liveCompletionPairMatches(after) {
      let event = getAfter(
        /databases/$(database)/documents/haetsalOrderCompletionEvents/$(after.completionEventId)
      ).data.data;
      let completionRequest = getAfter(
        /databases/$(database)/documents/haetsalOrderCompletionRequests/$(after.completionEventId)
      ).data.data;
      return event.orderId == after.orderId
        && event.liveOrderDocId == after.liveOrderDocId
        && event.productionCycle == after.productionCycle
        && event.completionEventId == after.completionEventId
        && event.status == after.status
        && event.statusRevision == after.statusRevision
        && completionRequest.orderId == after.orderId
        && completionRequest.liveOrderDocId == after.liveOrderDocId
        && completionRequest.productionCycle == after.productionCycle
        && completionRequest.completionEventId == after.completionEventId
        && completionRequest.status == 'COMPLETED';
    }

    function hasValidCompletedLiveShape(after, docId) {
      return after is map
        && after.order is map
        && after.orderId is string
        && after.orderId.size() > 0
        && after.liveOrderDocId is string
        && after.liveOrderDocId == docId
        && isDoneStatus(after.status)
        && after.isOpen == false
        && after.workStage == 'DONE'
        && after.productionCycle is int
        && after.productionCycle >= 1
        && after.statusRevision is int
        && after.statusRevision >= 1
        && after.completionCommitted == true
        && after.completionEventId is string
        && after.completionEventId.size() > 0
        && after.order.id == after.orderId
        && after.order.status == after.status
        && after.order.isOpen == false
        && after.order.workStage == 'DONE'
        && after.order.productionCycle == after.productionCycle
        && after.order.statusRevision == after.statusRevision
        && after.order.completionCommitted == true
        && after.order.completionEventId == after.completionEventId;
    }

    function validCompletedLiveCreate(docId) {
      let after = request.resource.data.data;
      return isFreshClientCreate()
        && hasPayloadMap()
        && hasValidCompletedLiveShape(after, docId)
        && liveCompletionPairMatches(after);
    }

    function hasOfficialSequence(data) {
      return data is map
        && data.keys().hasAll(['sequenceAllocationSource'])
        && data.sequenceAllocationSource == 'FIRESTORE_TRANSACTION';
    }

    function preservesOfficialSequence(before, after) {
      return !hasOfficialSequence(before)
        || (
          after.sequenceAllocationSource == before.sequenceAllocationSource
          && after.sequenceReservationId == before.sequenceReservationId
          && after.sequenceDate == before.sequenceDate
          && after.seq == before.seq
          && after.orderNumber == before.orderNumber
          && after.order is map
          && before.order is map
          && after.order.sequenceAllocationSource == before.order.sequenceAllocationSource
          && after.order.sequenceReservationId == before.order.sequenceReservationId
          && after.order.sequenceDate == before.order.sequenceDate
          && after.order.seq == before.order.seq
          && after.order.orderNumber == before.order.orderNumber
        );
    }

    function preservesOrInitializesOpenLifecycle(before, after) {
      return (
          (
            before.keys().hasAll(['productionCycle'])
            && after.productionCycle == before.productionCycle
          )
          || (
            !before.keys().hasAll(['productionCycle'])
            && after.productionCycle == 1
          )
        )
        && (
          (
            before.keys().hasAll(['statusRevision'])
            && after.statusRevision == before.statusRevision
          )
          || (
            !before.keys().hasAll(['statusRevision'])
            && after.statusRevision == 1
          )
        )
        && (
          (
            before.keys().hasAll(['completionCommitted'])
            && after.completionCommitted == before.completionCommitted
          )
          || (
            !before.keys().hasAll(['completionCommitted'])
            && after.completionCommitted == false
          )
        )
        && (
          (
            before.keys().hasAll(['completionEventId'])
            && after.completionEventId == before.completionEventId
          )
          || (
            !before.keys().hasAll(['completionEventId'])
            && after.completionEventId == ''
          )
        );
    }

    function advancesOrInitializesCompletionLifecycle(before, after) {
      return (
          (
            before.keys().hasAll(['productionCycle'])
            && after.productionCycle == before.productionCycle
          )
          || (
            !before.keys().hasAll(['productionCycle'])
            && after.productionCycle == 1
          )
        )
        && (
          (
            before.keys().hasAll(['statusRevision'])
            && after.statusRevision == before.statusRevision + 1
          )
          || (
            !before.keys().hasAll(['statusRevision'])
            && after.statusRevision == 2
          )
        );
    }

    function orderEditCouponCost(order) {
      return order.couponPolicyVersion >= 2
        ? order.couponCostTotal
        : order.quantity;
    }

    function hasValidOrderEditCouponCost(order) {
      return order is map
        && order.couponPolicyVersion is int
        && order.quantity is int
        && order.quantity >= 1
        && (
          order.couponPolicyVersion < 2
          || (
            order.couponCostTotal is int
            && order.couponCostTotal >= 1
          )
        );
    }

    function orderEditCouponOperationUnchanged(before, after) {
      return hasValidOrderEditCouponCost(before.order)
        && hasValidOrderEditCouponCost(after.order)
        && orderEditCouponCost(after.order) == orderEditCouponCost(before.order)
        && (
          (
            !after.order.keys().hasAny(['couponBalanceOperationId'])
            && !before.order.keys().hasAny(['couponBalanceOperationId'])
          )
          || (
            after.order.keys().hasAll(['couponBalanceOperationId'])
            && before.order.keys().hasAll(['couponBalanceOperationId'])
            && after.order.couponBalanceOperationId == before.order.couponBalanceOperationId
            && (
              !after.order.keys().hasAny(['remainingCoupons'])
              || (
                before.order.keys().hasAll(['remainingCoupons'])
                && after.order.remainingCoupons == before.order.remainingCoupons
              )
            )
          )
        );
    }

    function validOrderEditCouponMutation(before, after) {
      let event = getAfter(
        /databases/$(database)/documents/haetsalCombinedApp/$(after.order.orderEditCouponEventId)
      ).data.data;
      return after.order.keys().hasAll([
          'couponBalanceOperationId', 'orderEditCouponEventId',
          'remainingCoupons', 'couponBalanceVersion'
        ])
        && after.order.couponBalanceOperationId == after.orderEditOperationId
        && after.order.orderEditCouponEventId.matches('coupon_event_.*')
        && event.payloadKind == 'coupon-event'
        && event.type == 'COUPON_ORDER_EDIT'
        && event.orderId == after.orderId
        && event.userId == after.order.userId
        && event.sourceLogId == after.orderEditOperationId
        && event.delta is int
        && event.delta != 0
        && event.beforeCoupons is int
        && event.remainingCoupons is int
        && hasValidOrderEditCouponCost(before.order)
        && hasValidOrderEditCouponCost(after.order)
        && event.delta == -(orderEditCouponCost(after.order) - orderEditCouponCost(before.order))
        && event.beforeCoupons + event.delta == event.remainingCoupons
        && event.remainingCoupons == after.order.remainingCoupons;
    }

    function validOrderEditLiveUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return hasPayloadMap()
        && before is map
        && before.order is map
        && after.order is map
        && after.reason == 'order-edited-transaction'
        && after.orderEditOperationId is string
        && after.orderEditOperationId.size() > 0
        && after.order.orderEditOperationId == after.orderEditOperationId
        && after.orderId == before.orderId
        && after.liveOrderDocId == docId
        && after.order.id == before.order.id
        && after.order.id == after.orderId
        && after.order.userId == before.order.userId
        && !isDoneStatus(before.status)
        && before.status != 'CANCELLED'
        && !isDoneStatus(after.status)
        && after.status != 'CANCELLED'
        && after.status == before.status
        && after.isOpen == true
        && after.isOpen == before.isOpen
        && after.workStage == before.workStage
        && after.stageRevision == before.stageRevision
        && after.stageUpdatedAt == before.stageUpdatedAt
        && after.orderNumber == before.orderNumber
        && preservesOrInitializesOpenLifecycle(before, after)
        && preservesOfficialSequence(before, after)
        && after.diff(before).affectedKeys().hasOnly([
          'version', 'appVersion', 'reason', 'orderId', 'liveOrderDocId',
          'orderNumber', 'status', 'isOpen', 'statusUpdatedAt',
          'productionCycle', 'statusRevision', 'workStage', 'stageRevision',
          'stageUpdatedAt', 'completionCommitted', 'completionEventId',
          'updatedAt', 'orderEditOperationId', 'order', '__haetsalDataGuard'
        ])
        && after.order.diff(before.order).affectedKeys().hasOnly([
          'items', 'quantity', 'couponPolicyVersion', 'couponCostTotal',
          'deliveryType', 'deliveryLocation', 'cupType', 'tumblerInfo', 'memo',
          'remainingCoupons', 'couponsUpdatedAt', 'couponBalanceOperationId',
          'couponBalanceVersion', 'lastRecalcRunId', 'editedAt', 'editedBy',
          'orderEditOperationId', 'orderEditCouponEventId'
        ])
        && orderEditCouponOperationUnchanged(before, after);
    }

    function validOpenLiveUpdate() {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return hasPayloadMap()
        && before is map
        && !isDoneStatus(before.status)
        && !isDoneStatus(after.status)
        && after.reason != 'order-edited-transaction'
        && after.orderId == before.orderId
        && preservesOrInitializesOpenLifecycle(before, after)
        && preservesOfficialSequence(before, after);
    }

    function isDeliveryLivePayload(data) {
      return data is map
        && (
          (data.keys().hasAll(['deliveryType']) && data.deliveryType == 'DELIVERY')
          || (data.keys().hasAll(['order']) && data.order is map && data.order.keys().hasAll(['deliveryType']) && data.order.deliveryType == 'DELIVERY')
        );
    }

    function hasDeliveryCompletionSourceStage(data) {
      return data is map
        && (
          (data.keys().hasAll(['workStage']) && data.workStage == 'DELIVERING')
          || (data.keys().hasAll(['order']) && data.order is map && data.order.keys().hasAll(['workStage']) && data.order.workStage == 'DELIVERING')
          || (
            (
              (data.keys().hasAll(['workStage']) && data.workStage == 'DELIVERY_WAITING')
              || (data.keys().hasAll(['order']) && data.order is map && data.order.keys().hasAll(['workStage']) && data.order.workStage == 'DELIVERY_WAITING')
            )
            && (
              (data.keys().hasAll(['productionCompleted']) && data.productionCompleted == true)
              || (data.keys().hasAll(['productionCompletedAt']) && data.productionCompletedAt is string && data.productionCompletedAt.size() > 0)
              || (data.keys().hasAll(['order']) && data.order is map && data.order.keys().hasAll(['productionCompleted']) && data.order.productionCompleted == true)
              || (data.keys().hasAll(['order']) && data.order is map && data.order.keys().hasAll(['productionCompletedAt']) && data.order.productionCompletedAt is string && data.order.productionCompletedAt.size() > 0)
            )
          )
        );
    }

    function validLiveCompletionUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return hasPayloadMap()
        && before is map
        && !isDoneStatus(before.status)
        && before.status != 'CANCELLED'
        && (!isDeliveryLivePayload(before) || hasDeliveryCompletionSourceStage(before))
        && after.orderId == before.orderId
        && hasValidCompletedLiveShape(after, docId)
        && advancesOrInitializesCompletionLifecycle(before, after)
        && preservesOfficialSequence(before, after);
    }

    function hasLegacyCompletionNormalizationMarker(after) {
      return after is map
        && after.order is map
        && after.legacyCompletionNormalizedAt is string
        && after.legacyCompletionNormalizedAt.size() > 0
        && after.legacyCompletionNormalizedBy is string
        && after.legacyCompletionNormalizedSourceAppVersion is string
        && after.legacyCompletionNormalizedCurrentAppVersion is string
        && after.legacyCompletionNormalizedCurrentAppVersion.size() > 0
        && after.order.legacyCompletionNormalizedAt == after.legacyCompletionNormalizedAt
        && after.order.legacyCompletionNormalizedBy == after.legacyCompletionNormalizedBy
        && after.order.legacyCompletionNormalizedSourceAppVersion == after.legacyCompletionNormalizedSourceAppVersion
        && after.order.legacyCompletionNormalizedCurrentAppVersion == after.legacyCompletionNormalizedCurrentAppVersion;
    }

    function hasExplicitPositiveProductionCycle(data) {
      return data is map
        && data.keys().hasAll(['productionCycle'])
        && data.productionCycle is int
        && data.productionCycle >= 1;
    }

    function beforeHasNoClosedLegacyCompletionState(before, after) {
      return before is map
        && !isDoneStatus(before.status)
        && before.status != 'CANCELLED'
        && (!before.keys().hasAll(['orderId']) || before.orderId == after.orderId)
        && (!before.keys().hasAll(['liveOrderDocId']) || before.liveOrderDocId == after.liveOrderDocId)
        && (!hasExplicitPositiveProductionCycle(before) || before.productionCycle == after.productionCycle)
        && (!before.keys().hasAll(['completionCommitted']) || before.completionCommitted == false)
        && (!before.keys().hasAll(['completionEventId']) || before.completionEventId == '')
        && (
          !before.keys().hasAll(['order'])
          || (
            before.order is map
            && !isDoneStatus(before.order.status)
            && before.order.status != 'CANCELLED'
            && (!before.order.keys().hasAll(['completionCommitted']) || before.order.completionCommitted == false)
            && (!before.order.keys().hasAll(['completionEventId']) || before.order.completionEventId == '')
          )
        );
    }

    function validLegacyCompletionNormalizedLiveCompletionUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return hasPayloadMap()
        && beforeHasNoClosedLegacyCompletionState(before, after)
        && hasValidCompletedLiveShape(after, docId)
        && hasLegacyCompletionNormalizationMarker(after)
        && after.reason == 'order-completed-transaction'
        && docId == 'live_order_' + after.orderId
        && preservesOfficialSequence(before, after);
    }

    function validLegacyCompletionNormalizedLiveCompletionCreate(docId) {
      let after = request.resource.data.data;
      return isFreshClientCreate()
        && hasPayloadMap()
        && hasValidCompletedLiveShape(after, docId)
        && hasLegacyCompletionNormalizationMarker(after)
        && after.reason == 'order-completed-transaction'
        && docId == 'live_order_' + after.orderId;
    }

    function preservesCompletedLiveState(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return hasPayloadMap()
        && before is map
        && isDoneStatus(before.status)
        && after.order is map
        && after.orderId == before.orderId
        && after.liveOrderDocId == docId
        && (
          !before.keys().hasAll(['liveOrderDocId'])
          || after.liveOrderDocId == before.liveOrderDocId
        )
        && after.status == before.status
        && after.isOpen == false
        && after.workStage == 'DONE'
        && after.productionCycle == before.productionCycle
        && after.statusRevision == before.statusRevision
        && after.completionCommitted == before.completionCommitted
        && after.completionEventId == before.completionEventId
        && after.order.id == after.orderId
