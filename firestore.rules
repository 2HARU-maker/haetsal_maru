          || (data.included == false && data.exclusionReason == 'OFFLINE_EDIT_ADJUSTMENT_EXCLUDED')
        )
        && data.evidenceDigest is string
        && data.evidenceDigest.size() > 0
        && data.evidenceDigest.size() <= 40
        && data.createdAtClient is string
        && data.createdAtClient.size() > 0
        && data.createdAtClient.size() <= 240
        && data.storageLocation == 'haetsalRestoreAuditRuns'
        && validRestoreAuditDataGuard(data);
    }

    function validCouponRecalcRunCreate(docId) {
      let data = request.resource.data.data;
      return isAdmin()
        && isFreshClientCreate()
        && hasPayloadMap()
        && isCouponRecalcRunDocId(docId)
        && data is map
        && data.payloadKind == 'coupon-recalc-run'
        && data.runId is string
        && data.runId.size() > 0
        && docId == 'coupon_recalc_run_' + data.runId
        && data.userId is string
        && data.userId.size() > 0
        && data.startDate is string
        && data.startBalance is int
        && data.finalBalance is int
        && data.sourceFingerprint is string
        && data.algorithmVersion is int
        && data.status == 'APPLIED'
        && data.appliedAtClient is string;
    }

    function validCouponRecalcItemCreate(docId) {
      let data = request.resource.data.data;
      return isAdmin()
        && isFreshClientCreate()
        && hasPayloadMap()
        && isCouponRecalcItemDocId(docId)
        && data is map
        && data.payloadKind == 'coupon-recalc-item'
        && data.runId is string
        && data.runId.size() > 0
        && data.userId is string
        && data.userId.size() > 0
        && data.chunkId is string
        && data.chunkId.size() > 0
        && docId == 'coupon_recalc_item_' + data.chunkId
        && data.chunkIndex is int
        && data.chunkIndex >= 1
        && data.items is list
        && data.algorithmVersion is int
        && data.appliedAtClient is string;
    }

    function validCouponRecalcLatestCreate(docId) {
      let data = request.resource.data.data;
      return isAdmin()
        && isFreshClientCreate()
        && hasPayloadMap()
        && isCouponRecalcLatestDocId(docId)
        && data is map
        && data.payloadKind == 'coupon-recalc-latest'
        && data.runId is string
        && data.runId.size() > 0
        && data.userId is string
        && data.userId.size() > 0
        && data.finalBalance is int
        && data.sourceFingerprint is string
        && data.algorithmVersion is int
        && data.appliedAtClient is string
        && data.chunkDocIds is list;
    }

    function validCouponRecalcLatestUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isAdmin()
        && isFreshClientUpdate()
        && hasPayloadMap()
        && isCouponRecalcLatestDocId(docId)
        && before is map
        && after is map
        && before.payloadKind == 'coupon-recalc-latest'
        && after.payloadKind == 'coupon-recalc-latest'
        && before.userId == after.userId
        && after.runId is string
        && after.runId.size() > 0
        && after.userId is string
        && after.userId.size() > 0
        && after.finalBalance is int
        && after.sourceFingerprint is string
        && after.algorithmVersion is int
        && after.appliedAtClient is string
        && after.chunkDocIds is list;
    }

    // 기존 Rules의 읽기 허용 범위는 유지합니다.
    // 보호 대상 컬렉션 외의 기존 쓰기 동작도 그대로 유지합니다.
    function validOrderEditDiagnosticCreate(docId) {
      let data = request.resource.data.data;
      return isFreshClientCreate()
        && hasPayloadMap()
        && isOrderEditDiagnosticDocId(docId)
        && data is map
        && data.payloadKind == 'order-edit-diagnostic'
        && data.id is string
        && data.id.size() > 0
        && data.docId == docId
        && data.orderId is string
        && data.userId is string
        && data.status is string
        && data.clientAttemptAt is string;
    }

    function validOrderEditDiagnosticUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isFreshClientUpdate()
        && hasPayloadMap()
        && isOrderEditDiagnosticDocId(docId)
        && before is map
        && after is map
        && before.payloadKind == 'order-edit-diagnostic'
        && after.payloadKind == 'order-edit-diagnostic'
        && before.id == after.id
        && before.docId == after.docId
        && before.orderId == after.orderId
        && before.userId == after.userId
        && after.id is string
        && after.id.size() > 0
        && after.docId == docId
        && after.orderId is string
        && after.userId is string
        && after.status is string
        && after.clientAttemptAt is string;
    }

    function hasProtectedExternalWriteEnvelope() {
      return isSignedIn()
        && request.resource.data.data is map
        && request.resource.data.clientBuildNumber is int
        && request.resource.data.clientBuildNumber >= 202607111414
        && request.resource.data.clientBuildLabel is string
        && request.resource.data.writeSchemaVersion is int
        && request.resource.data.writeSchemaVersion >= 5
        && request.resource.data.clientWriteAt is string
        && request.resource.data.clientWriteId is string
        && request.resource.data.clientWriteId.size() > 0
        && request.resource.data.data.__haetsalDataGuard is map;
    }

    function isDeliveryRecordStatus(status) {
      return status is string
        && (status == 'WAITING' || status == 'STARTED' || status == 'COMPLETED' || status == 'CANCELLED');
    }

    function validDeliveryRecordData(docId, data) {
      return data is map
        && data.keys().hasAll([
          'version', 'type', 'orderId', 'orderNumber', 'seq', 'userId',
          'userName', 'userNameDisplay', 'userDept', 'deliveryLocation',
          'quantity', 'totalQty', 'items', 'memo', 'status', 'createdAt',
          'orderCreatedAt', 'startedAt', 'completedAt', 'cancelledAt',
          'startedBy', 'completedBy', 'cancelledBy', 'reason', 'updatedAt',
          '__haetsalDataGuard'
        ])
        && data.keys().hasOnly([
          'version', 'type', 'orderId', 'orderNumber', 'seq', 'userId',
          'userName', 'userNameDisplay', 'userDept', 'deliveryLocation',
          'quantity', 'totalQty', 'items', 'memo', 'status', 'createdAt',
          'orderCreatedAt', 'startedAt', 'completedAt', 'cancelledAt',
          'startedBy', 'completedBy', 'cancelledBy', 'reason', 'updatedAt',
          '__haetsalDataGuard'
        ])
        && data.version is int
        && data.version == 1
        && data.type == 'ORDER_DELIVERY_RECORD'
        && data.orderId is string
        && data.orderId.size() > 0
        && docId == data.orderId
        && data.orderNumber is string
        && (data.seq is int || data.seq is string)
        && data.userId is string
        && data.userName is string
        && data.userNameDisplay is string
        && data.userDept is string
        && data.deliveryLocation is string
        && data.quantity is int
        && data.quantity >= 0
        && data.totalQty is int
        && data.totalQty >= 0
        && data.items is list
        && data.memo is string
        && isDeliveryRecordStatus(data.status)
        && data.createdAt is string
        && data.orderCreatedAt is string
        && data.startedAt is string
        && data.completedAt is string
        && data.cancelledAt is string
        && data.startedBy is string
        && data.completedBy is string
        && data.cancelledBy is string
        && data.reason is string
        && data.updatedAt is string
        && data.__haetsalDataGuard is map;
    }

    function validDeliveryStatusTransition(beforeStatus, afterStatus) {
      return beforeStatus == afterStatus
        || (beforeStatus == 'WAITING' && (afterStatus == 'STARTED' || afterStatus == 'COMPLETED' || afterStatus == 'CANCELLED'))
        || (beforeStatus == 'STARTED' && (afterStatus == 'COMPLETED' || afterStatus == 'CANCELLED'))
        || (beforeStatus == 'COMPLETED' && (afterStatus == 'WAITING' || afterStatus == 'CANCELLED'))
        || (beforeStatus == 'CANCELLED' && afterStatus == 'WAITING');
    }

    function validDeliveryRecordCreate(docId) {
      return hasProtectedExternalWriteEnvelope()
        && validDeliveryRecordData(docId, request.resource.data.data)
        && (isManager() || request.resource.data.data.status == 'WAITING');
    }

    function validDeliveryOrderEditUpdate(docId, before, after) {
      let liveDocId = 'live_order_' + after.orderId;
      let live = getAfter(
        /databases/$(database)/documents/haetsalCombinedApp/$(liveDocId)
      ).data.data;
      return isSignedIn()
        && hasProtectedExternalWriteEnvelope()
        && validDeliveryRecordData(docId, after)
        && before is map
        && after.reason == 'order-edited-transaction'
        && before.orderId == after.orderId
        && before.type == after.type
        && before.version == after.version
        && before.userId == after.userId
        && before.orderNumber == after.orderNumber
        && before.createdAt == after.createdAt
        && before.orderCreatedAt == after.orderCreatedAt
        && live.reason == 'order-edited-transaction'
        && live.orderId == after.orderId
        && live.order is map
        && live.order.userId == after.userId
        && live.order.orderNumber == after.orderNumber
        && live.order.items == after.items
        && live.order.quantity == after.quantity
        && live.order.quantity == after.totalQty
        && live.order.memo == after.memo
        && (
          (
            live.order.deliveryType == 'DELIVERY'
            && live.order.deliveryLocation == after.deliveryLocation
            && (
              after.status == before.status
              || (before.status == 'CANCELLED' && after.status == 'WAITING')
            )
          )
          || (
            live.order.deliveryType == 'PICKUP'
            && after.status == 'CANCELLED'
          )
        );
    }

    function validDeliveryRecordUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return (
          isManager()
          && hasProtectedExternalWriteEnvelope()
          && validDeliveryRecordData(docId, after)
          && before is map
          && before.orderId == after.orderId
          && before.type == after.type
          && before.version == after.version
          && before.userId == after.userId
          && before.orderNumber == after.orderNumber
          && before.createdAt == after.createdAt
          && before.orderCreatedAt == after.orderCreatedAt
          && validDeliveryStatusTransition(before.status, after.status)
        )
        || validDeliveryOrderEditUpdate(docId, before, after);
    }

    function isClosedGuardStatus(status) {
      return status is string
        && (status == 'PICKUP_DONE' || status == 'DELIVERY_DONE' || status == 'CANCELLED');
    }

    function validClosedOrderGuardData(docId, data) {
      return data is map
        && data.keys().hasAll([
          'version', 'type', 'id', 'orderId', 'guardId', 'orderNumber',
          'status', 'deliveryType', 'statusUpdatedAt', 'updatedAt',
          'processedAt', 'cancelledAt', 'statusTime', 'productionCycle',
          'statusRevision', 'reason', 'savedAt', 'savedTime', 'expiresAt',
          '__haetsalDataGuard'
        ])
        && data.keys().hasOnly([
          'version', 'type', 'id', 'orderId', 'guardId', 'orderNumber',
          'status', 'deliveryType', 'statusUpdatedAt', 'updatedAt',
          'processedAt', 'cancelledAt', 'statusTime', 'productionCycle',
          'statusRevision', 'reason', 'savedAt', 'savedTime', 'expiresAt',
          '__haetsalDataGuard'
        ])
        && data.version is int
        && data.version == 1
        && data.type == 'ORDER_CLOSED_GUARD'
        && data.id is string
        && data.orderId is string
        && data.orderId.size() > 0
        && data.id == data.orderId
        && data.guardId == docId
        && docId == 'closed_guard_' + data.orderId
        && data.orderNumber is string
        && isClosedGuardStatus(data.status)
        && data.deliveryType is string
        && data.statusUpdatedAt is string
        && data.updatedAt is string
        && data.processedAt is string
        && data.cancelledAt is string
        && data.statusTime is int
        && data.statusTime > 0
        && data.productionCycle is int
        && data.productionCycle >= 1
        && data.statusRevision is int
        && data.statusRevision >= 1
        && data.reason is string
        && data.savedAt is string
        && data.savedTime is int
        && data.savedTime > 0
        && data.expiresAt is int
        && data.expiresAt >= data.savedTime
        && data.__haetsalDataGuard is map;
    }

    function validClosedOrderGuardCreate(docId) {
      return isManager()
        && hasProtectedExternalWriteEnvelope()
        && validClosedOrderGuardData(docId, request.resource.data.data);
    }

    function validClosedOrderGuardUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isManager()
        && hasProtectedExternalWriteEnvelope()
        && validClosedOrderGuardData(docId, after)
        && before is map
        && before.id == after.id
        && before.orderId == after.orderId
        && before.guardId == after.guardId
        && before.type == after.type
        && before.version == after.version
        && after.statusTime >= before.statusTime
        && after.productionCycle >= before.productionCycle
        && after.statusRevision >= before.statusRevision
        && after.savedTime >= before.savedTime;
    }

    function validRevivedOrderGuardData(docId, data) {
      return data is map
        && data.keys().hasAll([
          'version', 'type', 'id', 'orderId', 'guardId', 'orderNumber',
          'userId', 'userName', 'status', 'deliveryType', 'quantity',
          'businessDate', 'statusUpdatedAt', 'statusTime', 'reason', 'category',
          'quarantineLive', 'refundRecordId', 'refundCorrectionStatus',
          'refundCorrectionAmount', 'refundCorrectionOperationId',
          'refundCorrectionAppliedAt', 'refundCorrectionError', 'savedAt',
          'savedTime', 'expiresAt', 'orderSnapshot', '__haetsalDataGuard'
        ])
        && data.keys().hasOnly([
          'version', 'type', 'id', 'orderId', 'guardId', 'orderNumber',
          'userId', 'userName', 'status', 'deliveryType', 'quantity',
          'businessDate', 'statusUpdatedAt', 'statusTime', 'reason', 'category',
          'quarantineLive', 'refundRecordId', 'refundCorrectionStatus',
          'refundCorrectionAmount', 'refundCorrectionOperationId',
          'refundCorrectionAppliedAt', 'refundCorrectionError', 'savedAt',
          'savedTime', 'expiresAt', 'orderSnapshot', '__haetsalDataGuard'
        ])
        && data.version is int
        && data.version == 1
        && data.type == 'ORDER_REVIVED_GUARD'
        && data.id is string
        && data.orderId is string
        && data.orderId.size() > 0
        && data.id == data.orderId
        && data.guardId == docId
        && docId == 'revived_guard_' + data.orderId
        && data.orderNumber is string
        && data.userId is string
        && data.userName is string
        && data.status is string
        && data.deliveryType is string
        && data.quantity is int
        && data.quantity >= 0
        && data.businessDate is string
        && data.statusUpdatedAt is string
        && data.statusTime is int
        && data.statusTime > 0
        && data.reason is string
        && data.category is string
        && data.quarantineLive is bool
        && data.refundRecordId is string
        && data.refundCorrectionStatus is string
        && data.refundCorrectionAmount is int
        && data.refundCorrectionAmount >= 0
        && data.refundCorrectionOperationId is string
        && data.refundCorrectionAppliedAt is string
        && data.refundCorrectionError is string
        && data.savedAt is string
        && data.savedTime is int
        && data.savedTime > 0
        && data.expiresAt is int
        && (data.orderSnapshot == null || data.orderSnapshot is map)
        && data.__haetsalDataGuard is map;
    }

    function validRevivedOrderGuardCreate(docId) {
      return isManager()
        && hasProtectedExternalWriteEnvelope()
        && validRevivedOrderGuardData(docId, request.resource.data.data);
    }

    function validRevivedOrderGuardUpdate(docId) {
      let before = resource.data.data;
      let after = request.resource.data.data;
      return isManager()
        && hasProtectedExternalWriteEnvelope()
        && validRevivedOrderGuardData(docId, after)
        && before is map
        && before.id == after.id
        && before.orderId == after.orderId
        && before.guardId == after.guardId
        && before.type == after.type
        && before.version == after.version
        && after.statusTime >= before.statusTime
        && after.savedTime >= before.savedTime;
    }

    match /{topCollection}/{document=**} {
      allow read: if isSignedIn()
        && topCollection != 'haetsalCombinedApp'
        && topCollection != 'haetsalRestoreAuditRuns'
        && topCollection != 'haetsalRestoreAudits'
        && topCollection != 'haetsalUserAccountStatus'
        && topCollection != 'haetsalUserAccountStatusEvents'
        && topCollection != 'haetsalMaterialSupport'
        && topCollection != 'haetsalMaterialSupportSummary'
        && topCollection != 'haetsalMilkSupportRequests'
        && topCollection != 'haetsalCouponRecordNotes'
        && topCollection != 'haetsalOfflineCouponEdits';
      allow create, update, delete: if isSignedIn()
        && topCollection != 'haetsalCombinedApp'
        && topCollection != 'haetsalRestoreAuditRuns'
        && topCollection != 'haetsalRestoreAudits'
        && topCollection != 'haetsalCompletedOrders'
        && topCollection != 'haetsalOrderCompletionEvents'
        && topCollection != 'haetsalOrderCompletionRequests'
        && topCollection != 'haetsalOrderSequenceCounters'
        && topCollection != 'haetsalOrderSequenceReservations'
        && topCollection != 'haetsalOrderArchiveMarks'
        && topCollection != 'haetsalOrderDeliveryRecords'
        && topCollection != 'haetsalOrderClosedGuards'
        && topCollection != 'haetsalOrderRevivedGuards'
        && topCollection != 'haetsalUserAccountStatus'
        && topCollection != 'haetsalUserAccountStatusEvents'
        && topCollection != 'haetsalMaterialSupport'
        && topCollection != 'haetsalMaterialSupportSummary'
        && topCollection != 'haetsalMilkSupportRequests'
        && topCollection != 'haetsalCouponRecordNotes'
        && topCollection != 'haetsalOfflineCouponEdits';
    }

    match /haetsalOfflineCouponEdits/{docId} {
      allow read: if isAdmin();
      allow create: if
        (isOfflineCouponEditCurrentDocId(docId) && validOfflineCouponEditCurrentCreate(docId))
        || (isOfflineCouponEditAuditDocId(docId) && validOfflineCouponEditAuditCreate(docId));
      allow update: if isOfflineCouponEditCurrentDocId(docId)
        && validOfflineCouponEditCurrentUpdate(docId);
      allow delete: if false;
    }

    match /haetsalOrderDeliveryRecords/{docId} {
      allow read: if isSignedIn();
      allow create: if validDeliveryRecordCreate(docId);
      allow update: if validDeliveryRecordUpdate(docId);
      allow delete: if false;
    }

    match /haetsalOrderClosedGuards/{docId} {
      allow read: if isSignedIn();
      allow create: if validClosedOrderGuardCreate(docId);
      allow update: if validClosedOrderGuardUpdate(docId);
      allow delete: if false;
    }

    match /haetsalOrderRevivedGuards/{docId} {
      allow read: if isSignedIn();
      allow create: if validRevivedOrderGuardCreate(docId);
      allow update: if validRevivedOrderGuardUpdate(docId);
      allow delete: if false;
    }

    match /haetsalRestoreAuditRuns/{runId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && validRestoreAuditOuterEnvelope()
        && validRestoreAuditRunCreate(runId);
      allow update, delete: if false;

      match /userCore/{userKey} {
        allow get, list: if isAdmin();
        allow create: if isAdmin()
          && validRestoreAuditOuterEnvelope()
          && validRestoreAuditCoreCreate(runId, userKey);
        allow update, delete: if false;
      }

      match /userLinkage/{userKey} {
        allow get, list: if isAdmin();
        allow create: if isAdmin()
          && validRestoreAuditOuterEnvelope()
          && validRestoreAuditLinkageCreate(runId, userKey);
        allow update, delete: if false;
      }

      match /sources/{sourceDocId} {
        allow get, list: if isAdmin();
        allow create: if isAdmin()
          && validRestoreAuditOuterEnvelope()
          && validRestoreAuditSourceCreate(runId, sourceDocId);
        allow update, delete: if false;
      }
    }

    match /haetsalRestoreAudits/{document=**} {
      allow read, create, update, delete: if false;
    }

    // 앱 실행 정책은 앱에서 읽기만 허용합니다.
    // 생성·수정·삭제는 Firebase 콘솔에서만 합니다.
    match /haetsalCombinedApp/app_runtime_policy {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // 사용자정보, 주문, 쿠폰, 텀블러, 안전 백업, 제작대기 큐,
    // 월별 보관 문서 등이 저장되는 주 컬렉션입니다.
    match /haetsalCombinedApp/{docId} {
      allow get: if isSignedIn()
        && (!isOfflineCouponEditDocId(docId) || isAdmin())
        && (!isCouponRestoreAuditDocId(docId) || isAdmin())
        && (!isCouponRecalcDocId(docId) || isAdmin());
      allow list: if isAdmin()
        || (
          isManager()
          && request.query.limit <= 300
          && resource.data.data is map
          && resource.data.data.isOpen == true
        )
        || (
          isSignedIn()
          && request.query.limit <= 250
          && resource.data.data is map
          && resource.data.data.payloadKind == 'coupon-event'
        );
      allow create: if docId != 'app_runtime_policy'
        && hasCouponBalanceGuardSchema(docId)
        && (
          (isSharedPeopleAuthDocId(docId) && validSharedPeopleAuthCreate(docId))
          || (isCouponEventDocId(docId) && validCouponEventCreate(docId))
          || (isOfflineCouponUseDocId(docId) && validOfflineCouponUseCreate(docId))
          || (isCouponRecordResolutionDocId(docId) && validCouponRecordResolutionCreate(docId))
          || (isCouponRecalcRunDocId(docId) && validCouponRecalcRunCreate(docId))
          || (isCouponRecalcItemDocId(docId) && validCouponRecalcItemCreate(docId))
          || (isCouponRecalcLatestDocId(docId) && validCouponRecalcLatestCreate(docId))
          || (isOrderEditDiagnosticDocId(docId) && validOrderEditDiagnosticCreate(docId))
          || (
            !isSharedPeopleAuthDocId(docId)
            && !isCouponLedgerDocId(docId)
            && !isCouponRestoreAuditDocId(docId)
            && !isCouponRecalcDocId(docId)
            && !isOrderEditDiagnosticDocId(docId)
            && !isLiveOrderDocId(docId)
            && isFreshClientCreate()
          )
          || (
            !isCouponLedgerDocId(docId)
            && !isCouponRecalcDocId(docId)
            && isLiveOrderDocId(docId)
            && validLiveOrderCreate(docId)
          )
        );
      allow update: if docId != 'app_runtime_policy'
        && hasCouponBalanceGuardSchema(docId)
        && (
          (isSharedPeopleAuthDocId(docId) && validSharedPeopleAuthUpdate(docId))
          || (isCouponRecalcLatestDocId(docId) && validCouponRecalcLatestUpdate(docId))
          || (isOrderEditDiagnosticDocId(docId) && validOrderEditDiagnosticUpdate(docId))
          || (
            !isSharedPeopleAuthDocId(docId)
            && !isCouponLedgerDocId(docId)
            && !isCouponRestoreAuditDocId(docId)
            && !isCouponRecalcDocId(docId)
            && !isOrderEditDiagnosticDocId(docId)
            && (
              (!isLiveOrderDocId(docId) && isFreshClientUpdate())
              || (isLiveOrderDocId(docId) && validLiveOrderUpdate(docId))
            )
          )
        );

      // 제작완료 원장, 쿠폰 원장, 재계산 원장 및 공식 접수번호와 연결되는 실시간 주문 문서는 앱에서 삭제할 수 없습니다.
      allow delete: if isSignedIn()
        && docId != 'app_runtime_policy'
        && !isSharedPeopleAuthDocId(docId)
        && !isLiveOrderDocId(docId)
        && !isCouponLedgerDocId(docId)
        && !isCouponRestoreAuditDocId(docId)
        && !isCouponRecalcDocId(docId);
    }

    // 완료 주문 개별 보관 문서
    match /haetsalCompletedOrders/{docId} {
      allow read: if isSignedIn();
      allow create: if isFreshClientCreate();
      allow update: if isFreshClientUpdate();
      allow delete: if false;
    }

    // 제작완료 중복 방지 및 완료 확정 이벤트 문서
    match /haetsalOrderCompletionEvents/{docId} {
      allow read: if isSignedIn();
      allow create: if validCompletionEventCreate(docId);
      allow update, delete: if false;
    }

    // 제작완료 요청 원장 문서
    match /haetsalOrderCompletionRequests/{docId} {
      allow read: if isSignedIn();
      allow create: if validCompletionRequestCreate(docId);
      allow update: if validCompletionRequestUpdate(docId);
      allow delete: if false;
    }

    // 날짜별 마지막 접수번호 카운터
    match /haetsalOrderSequenceCounters/{dateKey} {
      allow read: if isSignedIn();
      allow create: if validSequenceCounterCreate(dateKey);
      allow update: if validSequenceCounterUpdate(dateKey);
      allow delete: if false;
    }

    // 주문별 공식 접수번호 배정 원장
    match /haetsalOrderSequenceReservations/{docId} {
      allow read: if isSignedIn();
      allow create: if validSequenceReservationCreate(docId);
      allow update, delete: if false;
    }

    // 주문 보관/정리 완료 마커 문서
    match /haetsalOrderArchiveMarks/{docId} {
      allow read: if isSignedIn();
      allow create: if isFreshClientCreate();
      allow update: if isFreshClientUpdate();
      allow delete: if isSignedIn();
    }

    // 관리자 전용 사용자 이용 상태 현재값
    match /haetsalUserAccountStatus/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.userId == userId
        && request.resource.data.status is string
        && (request.resource.data.status == 'ACTIVE'
          || request.resource.data.status == 'SUSPENDED'
          || request.resource.data.status == 'DELETED')
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow delete: if false;
    }

    // 사용자 상태 변경 이력은 생성 후 변경하거나 삭제하지 않습니다.
    match /haetsalUserAccountStatusEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.eventId == eventId
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.status is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow update, delete: if false;
    }

    // 재료비 후원 상세 기록은 생성 후 변경하거나 삭제하지 않습니다.
    match /haetsalMaterialSupport/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.recordId == recordId
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.supportDate is string
        && request.resource.data.amountWon is int
        && request.resource.data.amountWon >= 0
        && request.resource.data.couponQuantity is int
        && request.resource.data.couponQuantity >= 0;
      allow update, delete: if false;
    }

    // 재료비 후원 횟수·금액·쿠폰 수량 요약
    match /haetsalMaterialSupportSummary/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.userId == userId
        && request.resource.data.supportState is string
        && (request.resource.data.supportState == 'RECORDED'
          || request.resource.data.supportState == 'NO_SUPPORT_CONFIRMED'
          || request.resource.data.supportState == 'REVIEW_REQUIRED')
        && request.resource.data.supportCount is int
        && request.resource.data.supportCount >= 0
        && request.resource.data.totalAmountWon is int
        && request.resource.data.totalAmountWon >= 0
        && request.resource.data.totalCouponQuantity is int
        && request.resource.data.totalCouponQuantity >= 0;
      allow delete: if false;
    }

    // 우유 후원 신청: 사용자는 신청만 하고, 매니저 검토 후 관리자만 쿠폰을 지급합니다.
    match /haetsalMilkSupportRequests/{requestId} {
      allow get: if isManager();
      allow list: if isManager()
        && request.query.limit <= 30
        && (
          (isAdmin() && resource.data.status == 'PAYMENT_PENDING')
          || resource.data.status == 'SUBMITTED'
          || resource.data.status == 'RETURNED_TO_MANAGER'
        );
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'requestId','status','userId','userName','userDept','itemCount','itemIds',
          'requestedTotal','approvedTotal','unitVolumeMl','createdByUid','createdAtClient','serverCreatedAt'
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.status == 'SUBMITTED'
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userDept is string
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 1
        && request.resource.data.itemCount <= 10
        && request.resource.data.itemIds is list
        && request.resource.data.itemIds.size() == request.resource.data.itemCount
        && request.resource.data.requestedTotal is int
        && request.resource.data.requestedTotal >= 1
        && request.resource.data.approvedTotal == 0
        && request.resource.data.unitVolumeMl == 200
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAtClient is string;
      allow update: if (
          isManager()
          && (resource.data.status == 'SUBMITTED' || resource.data.status == 'RETURNED_TO_MANAGER')
          && (request.resource.data.status == 'PAYMENT_PENDING' || request.resource.data.status == 'REJECTED')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','receivedDate','approvedTotal','managerReviewNote','managerReviewedByUid',
            'managerReviewedAtClient','serverManagerReviewedAt'
          ])
          && request.resource.data.receivedDate is string
          && request.resource.data.receivedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.approvedTotal is int
          && request.resource.data.approvedTotal >= 0
          && ((request.resource.data.status == 'PAYMENT_PENDING' && request.resource.data.approvedTotal > 0)
            || (request.resource.data.status == 'REJECTED' && request.resource.data.approvedTotal == 0))
          && request.resource.data.managerReviewedByUid == request.auth.uid
        )
        || (
          isAdmin()
          && resource.data.status == 'PAYMENT_PENDING'
          && request.resource.data.status == 'RETURNED_TO_MANAGER'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','adminReturnReason','adminReturnedByUid','adminReturnedAtClient','serverAdminReturnedAt'
          ])
          && request.resource.data.adminReturnReason is string
          && request.resource.data.adminReturnReason.size() > 0
          && request.resource.data.adminReturnedByUid == request.auth.uid
        )
        || (
          isAdmin()
          && resource.data.status == 'PAYMENT_PENDING'
          && request.resource.data.status == 'PAID'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','paidCouponQuantity','paymentOperationId','paidByUid','paidAtClient','serverPaidAt'
          ])
          && request.resource.data.paidCouponQuantity == resource.data.approvedTotal
          && request.resource.data.paidCouponQuantity is int
          && request.resource.data.paidCouponQuantity > 0
          && request.resource.data.paymentOperationId == 'milk-support-payment:' + requestId
          && request.resource.data.paidByUid == request.auth.uid
        )
        || (
          isAdmin()
          && resource.data.status == 'SUBMITTED'
          && request.resource.data.status == 'VOIDED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && !exists(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate)
          && existsAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate)
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.keys().hasOnly([
            'eventId','requestId','type','fromStatus','toStatus','reason','actorUid','createdAtClient','serverCreatedAt'
          ])
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.eventId == 'admin_void_duplicate'
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.requestId == requestId
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.type == 'VOIDED_AS_DUPLICATE'
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.fromStatus == 'SUBMITTED'
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.toStatus == 'VOIDED'
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.reason == 'DUPLICATE'
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.createdAtClient is string
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)/events/admin_void_duplicate).data.serverCreatedAt == request.time
        );
      allow delete: if false;

      match /items/{itemId} {
        allow get: if isManager();
        allow list: if isManager() && request.query.limit <= 10;
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'itemId','requestId','index','expiryDate','quantity','unitVolumeMl','createdByUid','createdAtClient'
          ])
          && request.resource.data.itemId == itemId
          && request.resource.data.requestId == requestId
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 10
          && request.resource.data.expiryDate is string
          && request.resource.data.expiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.unitVolumeMl == 200
          && request.resource.data.createdByUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.createdByUid == request.auth.uid;
        allow update: if isManager()
          && (get(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'SUBMITTED'
            || get(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'RETURNED_TO_MANAGER')
          && (getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'PAYMENT_PENDING'
            || getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'REJECTED')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'verifiedExpiryDate','verifiedQuantity','approvedQuantity','managerDecision','eligibilityStatus','eligibilityReason',
            'operatingDays','managerReviewedByUid','managerReviewedAtClient','serverManagerReviewedAt'
          ])
          && request.resource.data.verifiedExpiryDate is string
          && request.resource.data.verifiedExpiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.verifiedQuantity is int
          && request.resource.data.verifiedQuantity >= 1
          && request.resource.data.approvedQuantity is int
          && request.resource.data.approvedQuantity >= 0
          && request.resource.data.approvedQuantity <= request.resource.data.verifiedQuantity
          && (request.resource.data.managerDecision == 'APPROVED' || request.resource.data.managerDecision == 'REJECTED')
          && ((request.resource.data.managerDecision == 'APPROVED' && request.resource.data.approvedQuantity > 0)
            || (request.resource.data.managerDecision == 'REJECTED' && request.resource.data.approvedQuantity == 0))
          && (request.resource.data.eligibilityStatus == '지급 기준 충족'
            || request.resource.data.eligibilityStatus == '추가 검토 필요'
            || request.resource.data.eligibilityStatus == '지급 기준 미충족')
          && ((request.resource.data.approvedQuantity > 0 && request.resource.data.eligibilityStatus == '지급 기준 충족')
            || (request.resource.data.approvedQuantity == 0 && request.resource.data.eligibilityStatus != '지급 기준 충족'))
          && request.resource.data.eligibilityReason is string
          && request.resource.data.operatingDays is int
          && request.resource.data.operatingDays >= 0
          && request.resource.data.managerReviewedByUid == request.auth.uid;
        allow delete: if false;
      }

      match /events/{eventId} {
        allow get: if isManager();
        allow list: if isManager() && request.query.limit <= 30;
        allow create: if request.resource.data.eventId == eventId
          && request.resource.data.requestId == requestId
          && request.resource.data.actorUid == request.auth.uid
          && (
            (request.resource.data.type == 'SUBMITTED'
              && eventId == 'submitted'
              && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.createdByUid == request.auth.uid)
            || (isManager() && request.resource.data.type == 'MANAGER_REVIEWED')
            || (isAdmin() && request.resource.data.type == 'RETURNED_TO_MANAGER')
            || (isAdmin() && request.resource.data.type == 'PAID' && eventId == 'admin_payment')
            || (isAdmin()
              && request.resource.data.type == 'VOIDED_AS_DUPLICATE'
              && eventId == 'admin_void_duplicate'
              && request.resource.data.keys().hasOnly([
                'eventId','requestId','type','fromStatus','toStatus','reason','actorUid','createdAtClient','serverCreatedAt'
              ])
              && request.resource.data.fromStatus == 'SUBMITTED'
              && request.resource.data.toStatus == 'VOIDED'
              && request.resource.data.reason == 'DUPLICATE'
              && request.resource.data.createdAtClient is string
              && request.resource.data.serverCreatedAt == request.time
              && get(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'SUBMITTED'
              && getAfter(/databases/$(database)/documents/haetsalMilkSupportRequests/$(requestId)).data.status == 'VOIDED')
          );
        allow update, delete: if false;
      }
    }

    // 쿠폰 원본 기록을 보존하면서 붙이는 관리자 메모
    match /haetsalCouponRecordNotes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.noteId == noteId
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.originalRecordKey is string
        && request.resource.data.originalRecordKey.size() > 0
        && request.resource.data.memo is string
        && request.resource.data.memo.size() > 0;
      allow update, delete: if false;
    }
  }
}


